{
  // User Tasks that recreate the Gitpod task tabs on folder open.
  //
  // Do not use isBackground: Cursor treats an empty problemMatcher as
  // "task finished" and closes the tab. Keep the process in the foreground
  // and never close the panel. keep-devenv-tab drops into zsh if the
  // command exits (welcome, missing logs, claude without a key).
  //
  // First time in this workspace: Command Palette ->
  // "Tasks: Manage Automatic Tasks" -> Allow.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Data Services",
      "type": "shell",
      "command": "${env:HOME}/.local/bin/keep-devenv-tab ${workspaceFolder}/tooling/devenvs/scripts/follow-logs.sh mysql consul consul-template memcached fluentd",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "PHP Services",
      "type": "shell",
      "command": "${env:HOME}/.local/bin/keep-devenv-tab ${workspaceFolder}/tooling/devenvs/scripts/follow-logs.sh php-fpm php-nginx",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "Devheh",
      "type": "shell",
      "command": "${env:HOME}/.local/bin/keep-devenv-tab tail -F /workspace/logs/devheh.log",
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "Renderer",
      "type": "shell",
      "command": "${env:HOME}/.local/bin/keep-devenv-tab pnpm dlx pm2 logs dev-main-server",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "Claude Code",
      "type": "shell",
      "command": "${env:HOME}/.local/bin/keep-devenv-tab ${workspaceFolder}/tooling/devenvs/scripts/claude-code.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "Ngrok",
      "type": "shell",
      "command": "${env:HOME}/.local/bin/keep-devenv-tab tail -F /workspace/logs/ngrok.log",
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "Welcome",
      "type": "shell",
      "command": "${env:HOME}/.local/bin/keep-devenv-tab ${workspaceFolder}/tooling/devenvs/scripts/welcome.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    }
  ]
}
